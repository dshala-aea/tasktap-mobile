#!/usr/bin/env bash
# Auto-regenerate drift/riverpod code after switching branches. Installed via
# `scripts/setup.sh` (sets core.hooksPath=.githooks).
set -euo pipefail

# git passes: $1 = previous HEAD, $2 = new HEAD, $3 = 1 for a branch checkout,
# 0 for a single-file checkout (e.g. `git checkout -- file`). Only regenerate
# on real branch switches.
if [ "${3:-0}" != "1" ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

echo "post-checkout: regenerating generated code (dart run build_runner build)..."
dart run build_runner build --delete-conflicting-outputs
