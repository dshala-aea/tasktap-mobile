<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <application
        android:label="tasktap_mobile"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!--
            No android:taskAffinity="" on MainActivity, deliberately.

            Flutter's template sets it so another app cannot claim this one's task. But AppAuth's
            AuthorizationManagementActivity is launchMode="singleTask", and a singleTask activity
            is placed in the task matching its affinity — an activity with no affinity belongs to
            no task, so Android hands it a fresh one on every launch. The instance that stored the
            pending authorization request is then never the instance that receives the browser's
            redirect, and AppAuth reports

                W/AppAuth: No stored state - unable to handle response

            Giving AppAuth the same empty affinity does not fix it: it is the emptiness that
            breaks singleTask, not the mismatch. Everything therefore stays on the default
            affinity — the application id — which is the arrangement AppAuth is built for.

            The trade-off is real: this restores Android's default task-affinity behaviour, which
            is what the template's line was hardening against. Signing in matters more, and every
            app shipping AppAuth runs this way.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
